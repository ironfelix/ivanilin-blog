---
import { siteHref } from '../utils/paths';

const aboutUrl = siteHref('/about/');
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${aboutUrl}`} />
    <link rel="canonical" href={new URL('/about/', Astro.site).href} />
    <title>Иван Ильин</title>
  </head>
  <body>
    <p>Перенаправление на <a href={aboutUrl}>страницу обо мне</a>…</p>
  </body>
</html>
