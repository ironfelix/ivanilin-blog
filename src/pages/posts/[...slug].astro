---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Copyright from '../../components/Copyright.astro';
import TocNav from '../../components/TocNav.astro';
import { site } from '../../site.config';
import { t } from '../../i18n';
import { absoluteUrl } from '../../utils/paths';
import {
  formatDate,
  getAdjacentPosts,
  getBlogPosts,
  postSlug,
  postUrl,
  tagUrl,
  type Post,
} from '../../utils/posts';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const allBlogPosts = await getBlogPosts();
  return allBlogPosts.map((post) => ({
    params: { slug: postSlug(post) },
    props: { post, allBlogPosts },
  }));
}

interface Props {
  post: Post;
  allBlogPosts: Post[];
}

const { post, allBlogPosts } = Astro.props;
const { Content, headings } = await render(post);
const { prev, next } = getAdjacentPosts(allBlogPosts, post);
const i18n = t(site.language);
const canonicalUrl = absoluteUrl(`/posts/${postSlug(post)}/`);
const dateIso = post.data.date.toISOString().split('T')[0];
const articlePublishedIso = post.data.date.toISOString();
const tocHeadings = headings.map((h) => ({
  depth: h.depth,
  slug: h.slug,
  text: h.text,
}));
const hasToc = tocHeadings.some((h) => h.depth >= 1 && h.depth <= 4);
---

<BaseLayout
  title={post.data.title}
  description={post.data.summary}
  pageId="post"
  canonicalUrl={canonicalUrl}
  articlePublishedTime={articlePublishedIso}
>
  <article class="post-article" itemscope itemtype="https://schema.org/Article">
    <link itemprop="mainEntityOfPage" href={canonicalUrl} />
    <meta itemprop="description" content={post.data.summary ?? site.description} />
    <meta itemprop="author" content={site.author} />
    <meta itemprop="publisher" content={site.title} />

    <div class="page-header">
      <h1 itemprop="headline">{post.data.title}</h1>
      <div class="post-meta">
        <div class="meta-container">
          <time class="meta-date" datetime={dateIso} itemprop="datePublished dateModified">
            {formatDate(post.data.date, site.language)}
          </time>
          {post.data.tags.length > 0 && (
            <div class="meta-tags">
              <ul class="tags-list">
                {post.data.tags.map((tag) => (
                  <li>
                    <a href={tagUrl(tag)} class="tag-badge">{tag}</a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>

      {hasToc && (
        <details class="mobile-toc">
          <summary>{i18n.toc}</summary>
          <nav class="mobile-toc-content" aria-label={i18n.toc}>
            <TocNav headings={tocHeadings} />
          </nav>
        </details>
      )}
    </div>

    <div class="post-content" itemprop="articleBody">
      <Content />
    </div>

    <Copyright postTitle={post.data.title} canonicalUrl={canonicalUrl} />

    {(prev || next) && (
      <nav class="post-navigation">
        {prev ? (
          <a href={postUrl(prev)} class="nav-link nav-prev">
            <small>← {i18n.prevPost}</small>
            <h3>{prev.data.title}</h3>
          </a>
        ) : (
          <div class="nav-link-placeholder" />
        )}
        {next ? (
          <a href={postUrl(next)} class="nav-link nav-next">
            <small>{i18n.nextPost} →</small>
            <h3>{next.data.title}</h3>
          </a>
        ) : (
          <div class="nav-link-placeholder" />
        )}
      </nav>
    )}
  </article>

  {hasToc && (
    <nav slot="toc" class="toc-area" aria-label={i18n.toc}>
      <h3>{i18n.toc}</h3>
      <TocNav headings={tocHeadings} />
    </nav>
  )}
</BaseLayout>

<style is:global>
  .post-content img { cursor: zoom-in; max-width: 100%; height: auto; }
  .img-lightbox {
    position: fixed; inset: 0; z-index: 9999;
    display: flex; align-items: center; justify-content: center;
    padding: 2vh 2vw; background: rgba(0, 0, 0, 0.82);
    cursor: zoom-out; overflow: auto;
  }
  .img-lightbox[hidden] { display: none; }
  .img-lightbox img {
    max-width: 100%; max-height: 96vh; width: auto; height: auto;
    background: #ffffff; border-radius: 10px; padding: 12px;
    box-shadow: 0 12px 48px rgba(0, 0, 0, 0.45);
  }
  @media (prefers-color-scheme: dark) {
    .img-lightbox img { background: #14181a; }
  }
  @media (max-width: 700px) {
    .img-lightbox img { max-width: none; width: auto; max-height: none; height: 88vh; }
  }
</style>

<script>
  const initLightbox = () => {
    const imgs = document.querySelectorAll(".post-content img");
    if (!imgs.length || document.querySelector(".img-lightbox")) return;
    const box = document.createElement("div");
    box.className = "img-lightbox";
    box.hidden = true;
    box.setAttribute("role", "dialog");
    box.setAttribute("aria-modal", "true");
    const big = document.createElement("img");
    box.appendChild(big);
    document.body.appendChild(box);
    const close = () => { box.hidden = true; document.body.style.overflow = ""; };
    imgs.forEach((im) => {
      im.addEventListener("click", () => {
        big.src = im.currentSrc || im.src;
        big.alt = im.alt || "";
        box.hidden = false;
        document.body.style.overflow = "hidden";
      });
    });
    box.addEventListener("click", close);
    document.addEventListener("keydown", (e) => { if (e.key === "Escape") close(); });
  };
  document.addEventListener("DOMContentLoaded", initLightbox);
</script>
